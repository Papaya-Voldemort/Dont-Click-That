# Production Deployment Configuration
# Copy this file to .env and adjust values as needed

# Port for production server (default: 3000)
PORT=3000

# Server host binding (default: localhost, use 0.0.0.0 for network access)
HOST=localhost

# Node environment (production or development)
NODE_ENV=production

# Optional: Port for Vite dev/preview server (dev only, default: 5173)
# PORT=5173

# Optional: Separate port for preview server (default: uses PORT or 4173)
# PREVIEW_PORT=4173
